{
  "name": "@local/dsh-world",
  "version": "0.2.77",
  "private": true,
  "type": "module",
  "description": "Win11 风格 DSH 桌面，内置 VSCode、局域网聊天（含发现诊断与 HTTP 在线兜底）、多标签浏览器、日记、待办、收纳盒和垃圾箱，支持桌面文件拖放与助手桌面截图。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build-client.mjs",
    "package": "node package.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:ui": "node tests/desktop-ui-browser.mjs",
    "test:native": "node tests/browser-native.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "vscode-app.js",
    "lan-chat-app.js",
    "browser-app.js",
    "browser-frame.js",
    "external-apps.js",
    "app-format.js",
    "plugin-apps.js",
    "plugin-catalog.js",
    "host-panels.js",
    "walker.js",
    "walker-path.js",
    "plane.js",
    "source-editor.js",
    "vscode-reveal.js",
    "wallpaper.js",
    "wallpaper-panel.js",
    "desktop-bridge.js",
    "desktop-tools.js",
    "desktop-shot.js",
    "desktop-client.js",
    "desktop-control.js",
    "desktop-ui.js",
    "desktop-ui-protocol.js",
    "desktop-brain.js",
    "assistant-activity.js",
    "assistant-pointer.js",
    "assistant-pointer-view.js",
    "assistant-conversation.js",
    "conversation-seat.js",
    "session-transcript.js",
    "workbench-profile.js",
    "workbench-setup.js",
    "workbench.js",
    "companion-time.js",
    "companion-memory.js",
    "companion-life.js",
    "journal.js",
    "journal-client.js",
    "journal-app.js",
    "task-app.js",
    "holder-app.js",
    "tasks.js",
    "git.js",
    "highlight.js",
    "vscode-search.js",
    "model-friends.js",
    "lan-chat-tool.js",
    "lan-chat",
    "app-packages",
    "README.md",
    "DESIGN.md",
    "APP-FORMAT.md",
    "BROWSER-DESIGN.md",
    "prototype/index.html",
    "cordis.patch.yml"
  ],
  "meta": {
    "title": "world",
    "description": "Win11 风格桌面、内置 VSCode / 局域网聊天 / 多标签浏览器 / 日记、待办、收纳盒和垃圾箱、.worldapp 与文件拖放、3D 景深地面与跟随鼠标的小机器人。"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-sandbox": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  }
}
