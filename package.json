{
  "name": "@local/dsh-world",
  "version": "0.3.66",
  "private": true,
  "type": "module",
  "description": "Win11 风格 DSH 桌面，支持手机扫码访问同一后台和窄屏手机桌面，内置 VSCode、终端（含 SSH）、EasyTier 上网、局域网聊天、多标签浏览器、DSH 进程管理器、日记、待办、收纳盒和垃圾箱。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build-client.mjs",
    "package": "node package.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:word-highlight": "node tests/word-highlight-browser.mjs",
    "test:zip-index": "node --expose-gc tests/zip-index-profile.mjs",
    "test:performance": "node tests/performance-browser.mjs",
    "test:git": "node --test tests/git.test.js tests/git-workflow.test.js",
    "test:git:browser": "node tests/git-workflow-browser.mjs && node tests/git-compose-performance.mjs",
    "test:empty-group": "node tests/vscode-empty-group-browser.mjs",
    "test:documents": "node tests/native-document-browser.mjs",
    "test:quick-open": "node tests/quick-open-browser.mjs",
    "test:srw": "node --test tests/srw-model.test.js tests/srw-canvas-index.test.js && node tests/srw-designer-browser.mjs && node tests/srw-member-select-browser.mjs",
    "test:srw-completion": "node --test tests/srw-completion.test.js && node tests/srw-completion-browser.mjs",
    "test:debug-log": "node --test tests/debug-log.test.js tests/pb-actions.test.js && node tests/debug-log-browser.mjs && node tests/pb-project-browser.mjs",
    "test:pb-backspace": "node --test tests/highlight.test.js && node tests/srm-designer-browser.mjs --backspace",
    "test:srm-profile": "node tests/srm-designer-browser.mjs --profile",
    "test:srm": "node --test tests/srm-model.test.js && node tests/srm-designer-browser.mjs",
    "test:srd": "node --test tests/srd-model.test.js && node tests/srd-designer-browser.mjs",
    "test:window-cache": "node tests/window-cache-browser.mjs",
    "test:tabs": "node tests/vscode-tabs-browser.mjs && node tests/tab-strip-performance.mjs",
    "test:vscode": "node tests/vscode-enhancements-browser.mjs",
    "test:folders": "node tests/vscode-folders-browser.mjs",
    "test:storage": "node tests/storage-manager-browser.mjs",
    "test:ports": "node tests/process-ports-browser.mjs",
    "test:internet": "node tests/internet-browser.mjs",
    "test:internet:runtime": "node tests/internet-runtime.mjs",
    "test:secretary:runtime": "node tests/secretary-runtime.mjs && node tests/secretary-runtime.mjs --ptc",
    "test:pbnpm:runtime": "node tests/pbnpm-runtime.mjs",
    "test:updates": "node tests/updates-browser.mjs",
    "test:updates:runtime": "node tests/updates-runtime.mjs",
    "test:app-tools": "node tests/app-tools-browser.mjs",
    "test:ui": "node tests/desktop-ui-browser.mjs",
    "test:native": "node tests/browser-native.mjs",
    "test:mobile": "node tests/mobile-runtime.mjs",
    "test:mobile-connect": "node tests/mobile-connect-browser.mjs",
    "test:qr": "node tests/mobile-qr-check.mjs"
  },
